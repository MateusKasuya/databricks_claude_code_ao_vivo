                  {"fieldName": "customer_name", "displayName": "Cliente"},
                  {"fieldName": "customer_country", "displayName": "País"},
                  {"fieldName": "total_orders", "displayName": "Pedidos"},
                  {
                    "fieldName": "total_revenue",
                    "displayName": "Receita",
                    "format": {"type": "number-currency", "currencyCode": "USD", "decimalPlaces": {"type": "max", "places": 2}}
                  },
                  {
                    "fieldName": "avg_ticket",
                    "displayName": "Ticket Médio",
                    "format": {"type": "number-currency", "currencyCode": "USD", "decimalPlaces": {"type": "exact", "places": 2}}
