                    {"name": "franchise_name", "expression": "`franchise_name`"},
                    {"name": "country", "expression": "`country`"},
                    {"name": "total_reviews", "expression": "`total_reviews`"},
                    {"name": "positive_reviews", "expression": "`positive_reviews`"},
                    {"name": "neutral_reviews", "expression": "`neutral_reviews`"},
                    {"name": "negative_reviews", "expression": "`negative_reviews`"},
