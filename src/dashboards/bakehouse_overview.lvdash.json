                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "bar",
              "encodings": {
                "x": {
                  "fieldName": "product",
                  "scale": {"type": "categorical", "sort": {"by": "value"}},
                  "displayName": "Produto"
                },
                "y": {"fieldName": "total_revenue", "scale": {"type": "quantitative"}, "displayName": "Receita"}
              },
              "frame": {"showTitle": true, "title": "Receita por Produto"}
            }
          },
          "position": {"x": 0, "y": 12, "width": 6, "height": 5}
        },
        {
          "widget": {
            "name": "franchise-ranking-table",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_franchise_performance",
                  "fields": [
                    {"name": "revenue_rank", "expression": "`revenue_rank`"},
                    {"name": "franchise_name", "expression": "`franchise_name`"},
                    {"name": "city", "expression": "`city`"},
                    {"name": "country", "expression": "`country`"},
                    {"name": "total_orders", "expression": "`total_orders`"},
                    {"name": "total_revenue", "expression": "`total_revenue`"},
                    {"name": "avg_ticket", "expression": "`avg_ticket`"}
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "table",
              "encodings": {
                "columns": [
                  {"fieldName": "revenue_rank", "displayName": "Rank"},
                  {"fieldName": "franchise_name", "displayName": "Franquia"},
                  {"fieldName": "city", "displayName": "Cidade"},
                  {"fieldName": "country", "displayName": "País"},
                  {"fieldName": "total_orders", "displayName": "Pedidos"},
                  {
                    "fieldName": "total_revenue",
                    "displayName": "Receita",
                    "format": {"type": "number-currency", "currencyCode": "USD", "abbreviation": "compact", "decimalPlaces": {"type": "max", "places": 2}}
                  },
                  {
                    "fieldName": "avg_ticket",
                    "displayName": "Ticket Médio",
                    "format": {"type": "number-currency", "currencyCode": "USD", "decimalPlaces": {"type": "exact", "places": 2}}
                  }
                ]
              },
              "frame": {"showTitle": true, "title": "Ranking de Franquias"}
            }
          },
          "position": {"x": 6, "y": 12, "width": 6, "height": 5}
        },
        {
          "widget": {
            "name": "franchise-map",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_franchise_performance",
                  "fields": [
                    {"name": "latitude", "expression": "`latitude`"},
                    {"name": "longitude", "expression": "`longitude`"},
                    {"name": "total_revenue", "expression": "`total_revenue`"},
                    {"name": "total_orders", "expression": "`total_orders`"}
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "symbol-map",
              "mark": {"opacity": 0.8},
              "encodings": {
                "coordinates": {
                  "latitude": {"fieldName": "latitude"},
                  "longitude": {"fieldName": "longitude"}
                },
                "color": {
                  "fieldName": "total_revenue",
                  "displayName": "Receita",
                  "scale": {
                    "type": "quantitative",
                    "colorRamp": {"mode": "custom-sequential", "colors": {"start": "#F0E442", "end": "#009E73"}}
                  }
                },
                "size": {"fieldName": "total_orders", "scale": {"type": "quantitative"}}
              },
              "frame": {"showTitle": true, "title": "Franquias por Receita (Mapa)"}
            }
          },
          "position": {"x": 0, "y": 17, "width": 8, "height": 6}
        },
        {
          "widget": {
            "name": "country-revenue-bar",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_sales_by_country",
                  "fields": [
                    {"name": "country", "expression": "`country`"},
                    {"name": "total_revenue", "expression": "`total_revenue`"}
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "bar",
              "encodings": {
                "x": {"fieldName": "total_revenue", "scale": {"type": "quantitative"}, "displayName": "Receita"},
                "y": {"fieldName": "country", "scale": {"type": "categorical", "sort": {"by": "value"}}, "displayName": "País"}
              },
              "frame": {"showTitle": true, "title": "Receita por País"}
            }
          },
          "position": {"x": 8, "y": 17, "width": 4, "height": 6}
        },
        {
          "widget": {
            "name": "header-customers-sentiment",
            "multilineTextboxSpec": {"lines": ["## Clientes e Sentimento dos Reviews"]}
          },
          "position": {"x": 0, "y": 23, "width": 12, "height": 1}
        },
        {
          "widget": {
            "name": "top-customers-table",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_top_customers",
                  "fields": [
                    {"name": "revenue_rank", "expression": "`revenue_rank`"},
                    {"name": "customer_name", "expression": "`customer_name`"},
                    {"name": "customer_country", "expression": "`customer_country`"},
                    {"name": "total_orders", "expression": "`total_orders`"},
                    {"name": "total_revenue", "expression": "`total_revenue`"},
                    {"name": "avg_ticket", "expression": "`avg_ticket`"}
                  ],
