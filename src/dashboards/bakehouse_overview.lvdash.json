    {
      "name": "filters",
      "displayName": "Filters",
      "pageType": "PAGE_TYPE_GLOBAL_FILTERS",
      "layoutVersion": "GRID_V1",
      "layout": [
        {
          "widget": {
            "name": "filter-date-range",
            "queries": [
              {
                "name": "ds_date",
                "query": {
                  "datasetName": "ds_daily_sales",
                  "fields": [{"name": "transaction_date", "expression": "`transaction_date`"}],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "filter-date-range-picker",
              "encodings": {
                "fields": [{"fieldName": "transaction_date", "queryName": "ds_date"}]
              },
              "frame": {"showTitle": true, "title": "Período"}
            }
          },
          "position": {"x": 0, "y": 0, "width": 4, "height": 2}
        },
        {
          "widget": {
            "name": "filter-country",
            "queries": [
              {
                "name": "q_daily_country",
                "query": {
                  "datasetName": "ds_daily_sales",
                  "fields": [{"name": "franchise_country", "expression": "`franchise_country`"}],
                  "disaggregated": false
                }
              },
              {
                "name": "q_franchise_country",
                "query": {
                  "datasetName": "ds_franchise_performance",
                  "fields": [{"name": "country", "expression": "`country`"}],
                  "disaggregated": false
                }
              },
              {
                "name": "q_country_country",
                "query": {
                  "datasetName": "ds_sales_by_country",
                  "fields": [{"name": "country", "expression": "`country`"}],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "filter-multi-select",
              "encodings": {
                "fields": [
                  {"fieldName": "franchise_country", "displayName": "País", "queryName": "q_daily_country"},
                  {"fieldName": "country", "displayName": "País (Franquias)", "queryName": "q_franchise_country"},
                  {"fieldName": "country", "displayName": "País (Resumo)", "queryName": "q_country_country"}
                ]
              },
              "frame": {"showTitle": true, "title": "País"}
            }
          },
          "position": {"x": 4, "y": 0, "width": 4, "height": 2}
        }
      ]
    }
  ],
  "uiSettings": {
    "theme": {
      "canvasBackgroundColor": {"light": "#FCFCFC", "dark": "#1F272D"},
      "widgetBackgroundColor": {"light": "#FFFFFF", "dark": "#11171C"},
      "widgetBorderColor": {"light": "#FFFFFF", "dark": "#11171C"},
      "fontColor": {"light": "#11171C", "dark": "#E8ECF0"},
      "selectionColor": {"light": "#2272B4", "dark": "#8ACAFF"},
      "visualizationColors": [
        "#0072B2", "#E69F00", "#009E73", "#CC79A7", "#D55E00", "#56B4E9", "#F0E442"
      ],
      "widgetHeaderAlignment": "LEFT"
    }
  }
}
