{
  "datasets": [
    {
      "name": "ds_daily_sales",
      "displayName": "Daily sales by franchise",
      "queryLines": [
        "SELECT transaction_date, franchiseID, franchise_name, franchise_country, total_orders, total_revenue \n",
        "FROM daily_sales_by_franchise"
      ],
      "columns": [
        {
          "displayName": "Total Revenue",
          "description": "Total revenue across the selected period",
          "expression": "SUM(`total_revenue`)"
        },
        {
          "displayName": "Total Orders",
          "description": "Total orders across the selected period",
          "expression": "SUM(`total_orders`)"
        },
        {
          "displayName": "Avg Ticket",
          "description": "Average order value",
          "expression": "SUM(`total_revenue`) / SUM(`total_orders`)"
        },
        {
          "displayName": "Active Franchises",
          "description": "Distinct franchises with at least one sale",
          "expression": "COUNT(DISTINCT `franchiseID`)"
        }
      ]
    },
    {
      "name": "ds_sales_by_product",
      "displayName": "Sales by product",
      "queryLines": [
        "SELECT product, total_orders, total_quantity, total_revenue, avg_ticket \n",
        "FROM sales_by_product \n",
        "ORDER BY total_revenue DESC"
      ]
    },
    {
      "name": "ds_franchise_performance",
      "displayName": "Franchise performance",
      "queryLines": [
        "SELECT franchiseID, franchise_name, city, country, latitude, longitude, total_orders, total_revenue, avg_ticket, revenue_rank \n",
        "FROM franchise_performance \n",
        "ORDER BY revenue_rank"
      ]
    },
    {
      "name": "ds_sales_by_country",
      "displayName": "Sales by country",
      "queryLines": [
        "SELECT country, total_franchises, total_orders, total_revenue, avg_ticket \n",
        "FROM sales_by_country \n",
        "ORDER BY total_revenue DESC"
      ]
    },
    {
      "name": "ds_top_customers",
      "displayName": "Top customers",
      "queryLines": [
        "SELECT customerID, customer_name, customer_country, total_orders, total_revenue, avg_ticket, revenue_rank \n",
        "FROM top_customers \n",
        "ORDER BY revenue_rank \n",
        "LIMIT 15"
      ]
    },
    {
      "name": "ds_payment_method",
      "displayName": "Sales by payment method",
      "queryLines": [
        "SELECT payment_method, total_orders, total_revenue, avg_ticket \n",
        "FROM sales_by_payment_method \n",
        "ORDER BY total_revenue DESC"
      ]
    },
    {
      "name": "ds_sentiment_mix",
      "displayName": "Overall review sentiment mix",
      "queryLines": [
        "SELECT 'Positive' AS sentiment, SUM(positive_reviews) AS review_count FROM sentiment_by_franchise \n",
        "UNION ALL SELECT 'Negative', SUM(negative_reviews) FROM sentiment_by_franchise \n",
        "UNION ALL SELECT 'Neutral', SUM(neutral_reviews) FROM sentiment_by_franchise \n",
        "UNION ALL SELECT 'Mixed', SUM(mixed_reviews) FROM sentiment_by_franchise"
      ]
    },
    {
      "name": "ds_sentiment_by_franchise",
      "displayName": "Review sentiment by franchise",
      "queryLines": [
        "SELECT franchiseID, franchise_name, country, total_reviews, positive_reviews, neutral_reviews, negative_reviews, mixed_reviews, positive_ratio \n",
        "FROM sentiment_by_franchise \n",
        "ORDER BY positive_ratio ASC"
      ]
    }
  ],
  "pages": [
    {
      "name": "overview",
      "displayName": "Overview",
      "pageType": "PAGE_TYPE_CANVAS",
      "layoutVersion": "GRID_V1",
      "layout": [
        {
          "widget": {
            "name": "title-header",
            "multilineTextboxSpec": {
              "lines": ["# Bakehouse — Visão Geral (Bronze → Silver → Gold)"]
            }
          },
          "position": {"x": 0, "y": 0, "width": 12, "height": 1}
        },
        {
          "widget": {
            "name": "subtitle-header",
            "multilineTextboxSpec": {
              "lines": ["48 franquias em 9 países — receita, pedidos, ticket médio, mix de produtos, desempenho por franquia/país e satisfação dos clientes."]
            }
          },
          "position": {"x": 0, "y": 1, "width": 12, "height": 1}
        },
        {
          "widget": {
            "name": "kpi-total-revenue",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_daily_sales",
                  "fields": [
                    {"name": "transaction_date", "expression": "`transaction_date`"},
                    {"name": "measure(Total Revenue)", "expression": "MEASURE(`Total Revenue`)"}
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "measure(Total Revenue)",
                  "displayName": "Receita Total",
                  "format": {
                    "type": "number-currency",
                    "currencyCode": "USD",
                    "abbreviation": "compact",
                    "decimalPlaces": {"type": "max", "places": 2}
                  }
                },
                "period": {"fieldName": "transaction_date"}
              },
              "frame": {"title": "Receita Total", "showTitle": true}
            }
          },
          "position": {"x": 0, "y": 2, "width": 3, "height": 3}
        },
        {
          "widget": {
            "name": "kpi-total-orders",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_daily_sales",
                  "fields": [
                    {"name": "transaction_date", "expression": "`transaction_date`"},
                    {"name": "measure(Total Orders)", "expression": "MEASURE(`Total Orders`)"}
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {"fieldName": "measure(Total Orders)", "displayName": "Pedidos"},
                "period": {"fieldName": "transaction_date"}
              },
              "frame": {"title": "Pedidos", "showTitle": true}
            }
          },
          "position": {"x": 3, "y": 2, "width": 3, "height": 3}
        },
        {
          "widget": {
            "name": "kpi-avg-ticket",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_daily_sales",
                  "fields": [
                    {"name": "transaction_date", "expression": "`transaction_date`"},
                    {"name": "measure(Avg Ticket)", "expression": "MEASURE(`Avg Ticket`)"}
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "measure(Avg Ticket)",
                  "displayName": "Ticket Médio",
                  "format": {
                    "type": "number-currency",
                    "currencyCode": "USD",
                    "decimalPlaces": {"type": "exact", "places": 2}
                  }
                },
                "period": {"fieldName": "transaction_date"}
              },
              "frame": {"title": "Ticket Médio", "showTitle": true}
            }
          },
          "position": {"x": 6, "y": 2, "width": 3, "height": 3}
        },
        {
          "widget": {
            "name": "kpi-active-franchises",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_daily_sales",
                  "fields": [
                    {"name": "measure(Active Franchises)", "expression": "MEASURE(`Active Franchises`)"}
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {"fieldName": "measure(Active Franchises)", "displayName": "Franquias Ativas"}
              },
              "frame": {"title": "Franquias Ativas", "showTitle": true}
            }
          },
          "position": {"x": 9, "y": 2, "width": 3, "height": 3}
        },
        {
          "widget": {
            "name": "header-revenue-trend",
            "multilineTextboxSpec": {"lines": ["## Tendência de Receita"]}
          },
          "position": {"x": 0, "y": 5, "width": 12, "height": 1}
        },
        {
          "widget": {
            "name": "daily-revenue-line",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_daily_sales",
                  "fields": [
                    {"name": "transaction_date", "expression": "`transaction_date`"},
                    {"name": "measure(Total Revenue)", "expression": "MEASURE(`Total Revenue`)"}
                  ],
                  "disaggregated": false,
                  "orders": [{"direction": "ASC", "expression": "`transaction_date`"}]
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "line",
              "encodings": {
                "x": {"fieldName": "transaction_date", "scale": {"type": "temporal"}, "displayName": "Data"},
                "y": {
                  "fieldName": "measure(Total Revenue)",
                  "scale": {"type": "quantitative", "domainMin": 0},
                  "displayName": "Receita"
                }
              },
              "frame": {"showTitle": true, "title": "Receita Diária"}
            }
          },
          "position": {"x": 0, "y": 6, "width": 8, "height": 5}
        },
        {
          "widget": {
            "name": "payment-mix-pie",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_payment_method",
                  "fields": [
                    {"name": "payment_method", "expression": "`payment_method`"},
                    {"name": "total_revenue", "expression": "`total_revenue`"}
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "pie",
              "encodings": {
                "angle": {"fieldName": "total_revenue", "scale": {"type": "quantitative"}, "displayName": "Receita"},
                "color": {
                  "fieldName": "payment_method",
                  "displayName": "Meio de Pagamento",
                  "scale": {
                    "type": "categorical",
                    "mappings": [
                      {"value": "amex", "color": "#0072B2"},
                      {"value": "mastercard", "color": "#E69F00"},
                      {"value": "visa", "color": "#009E73"}
                    ]
                  }
                },
                "label": {"show": true}
              },
              "frame": {"showTitle": true, "title": "Mix de Meio de Pagamento"}
            }
          },
          "position": {"x": 8, "y": 6, "width": 4, "height": 5}
        },
        {
          "widget": {
            "name": "header-products-franchise",
            "multilineTextboxSpec": {"lines": ["## Produtos e Performance por Franquia"]}
          },
          "position": {"x": 0, "y": 11, "width": 12, "height": 1}
        },
        {
          "widget": {
            "name": "product-revenue-bar",
            "queries": [
